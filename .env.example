# Required by Prisma and the API.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexiora"
JWT_SECRET="replace-with-a-long-random-secret"

# Set once to initialize the single Nexiora administrator. It is never stored in source.
ADMIN_INITIAL_PASSWORD="set-a-strong-password-before-first-start"
# Optional: leave these values unchanged to use the required initial identity.
ADMIN_USERNAME="sebastiandev"
ADMIN_EMAIL="yeremirojo@hotmail.com"
